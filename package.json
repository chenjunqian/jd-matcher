{
  "name": "jd-matcher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:cron": "wrangler dev --test-scheduled",
    "dev:db": "wrangler d1 execute jd-matcher-db --local --file ./migrations/001_initial.sql",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:init": "wrangler d1 execute jd-matcher-db --file ./migrations/001_initial.sql"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "ai": "^6.0.193",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.0.0",
    "grammy": "^1.35.0",
    "hono": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^4.20250301.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.0.0"
  }
}
